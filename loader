OrbitTarget_Button.MouseButton1Click:Connect(function()
	if TargetedPlayer ~= nil then
		ChangeToggleColor(OrbitTarget_Button)

		if OrbitTarget_Button.Ticket_Asset.ImageColor3 == ACTIVE_COLOR then
			local angle = 0
			local radius = 4
			local speed = 0.067
			local oldCameraSubject = workspace.CurrentCamera.CameraSubject
			local oldCameraType = workspace.CurrentCamera.CameraType

			workspace.CurrentCamera.CameraType = Enum.CameraType.Custom

			repeat
				pcall(function()
					if not GetRoot(plr):FindFirstChild("BreakVelocity") then
						local TempV = Velocity_Asset:Clone()
						TempV.Parent = GetRoot(plr)
					end

					local targetPlayer = Players[TargetedPlayer]
					local targetRoot = targetPlayer and GetRoot(targetPlayer)
					local targetHumanoid = targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass("Humanoid")

					if targetRoot then
						angle = angle + speed
						local offset = Vector3.new(
							math.cos(angle) * radius,
							1.5,
							math.sin(angle) * radius
						)

						local myRoot = GetRoot(plr)
						local orbitPos = targetRoot.Position + offset

						myRoot.CFrame = CFrame.lookAt(orbitPos, targetRoot.Position)
						myRoot.Velocity = Vector3.new(0, 0, 0)
					end

					if targetHumanoid then
						workspace.CurrentCamera.CameraSubject = targetHumanoid
					end
				end)

				task.wait()
			until OrbitTarget_Button.Ticket_Asset.ImageColor3 == INACTIVE_COLOR

			workspace.CurrentCamera.CameraSubject = oldCameraSubject
			workspace.CurrentCamera.CameraType = oldCameraType

			if GetRoot(plr):FindFirstChild("BreakVelocity") then
				GetRoot(plr).BreakVelocity:Destroy()
			end
		end
	end
end)

